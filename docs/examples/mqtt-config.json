{
  "$type": "Mqtt",
  "Host": "localhost",
  "Port": 1883,
  "ClientId": "IndustrialGateway_12345",
  "Username": null,
  "Password": null,
  "UseTls": false,
  "CleanSession": true,
  "KeepAlivePeriodSeconds": 60,
  "SubscribeTopics": [
    "factory/sensors/temperature",
    "factory/sensors/pressure",
    "factory/alarms/#"
  ],
  "QosLevel": 1,
  "Id": "mqtt-broker-001",
  "Name": "Factory MQTT Broker",
  "Enabled": true,
  "Tags": [
    {
      "Id": "tag-mqtt-001",
      "Name": "Temperature_Sensor",
      "Address": "factory/sensors/temperature",
      "DataType": "Float",
      "IsReadOnly": false,
      "ScanRateMs": 0,
      "Description": "Temperature sensor data via MQTT"
    },
    {
      "Id": "tag-mqtt-002",
      "Name": "Pressure_Sensor",
      "Address": "factory/sensors/pressure",
      "DataType": "Int32",
      "IsReadOnly": false,
      "ScanRateMs": 0,
      "Description": "Pressure sensor data via MQTT"
    }
  ],
  "DefaultScanRateMs": 1000
}
