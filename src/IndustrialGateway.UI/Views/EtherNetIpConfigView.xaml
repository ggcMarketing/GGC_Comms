<UserControl x:Class="IndustrialGateway.UI.Views.EtherNetIpConfigView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800"
             Background="#303030">

    <UserControl.Resources>
        <SolidColorBrush x:Key="GGC_Red" Color="#8c3030"/>
        <SolidColorBrush x:Key="GGC_Dark" Color="#303030"/>
        <SolidColorBrush x:Key="GGC_White" Color="#ffffff"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,15"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,5"/>
            <Setter Property="MinWidth" Value="200"/>
            <Setter Property="Background" Value="#505050"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Margin" Value="5,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="{StaticResource GGC_Red}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#a03838"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="10">
            <TextBlock Text="EtherNet/IP Configuration" 
                      FontSize="20" FontWeight="Bold" 
                      Foreground="{StaticResource GGC_White}"
                      Margin="0,0,0,20"/>

            <GroupBox Header="Connection Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3" 
                            Text="{Binding Config.Name, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Host/IP Address:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" 
                            Text="{Binding Config.Host, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="1" Grid.Column="2" Text="Port:" Style="{StaticResource LabelStyle}" Margin="20,0,10,0"/>
                    <TextBox Grid.Row="1" Grid.Column="3" 
                            Text="{Binding Config.Port, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Processor Slot:" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="2" Grid.Column="1" 
                            Text="{Binding Config.ProcessorSlot, UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </GroupBox>

            <GroupBox Header="Connection Status">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Status: " FontWeight="Bold" Foreground="{StaticResource GGC_White}"/>
                        <TextBlock Text="{Binding State}" Foreground="{StaticResource GGC_White}"/>
                    </StackPanel>
                    
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Connect" Width="100"/>
                        <Button Content="Disconnect" Width="100"/>
                        <Button Content="Test Connection" Width="120"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Tag Configuration">
                <StackPanel>
                    <TextBlock Text="Configure tags to read/write from the PLC" 
                              Foreground="{StaticResource GGC_White}"
                              Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Add Tag" Width="100"/>
                        <Button Content="Remove Tag" Width="100"/>
                        <Button Content="Import Tags" Width="100"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Advanced Settings">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Timeout (ms):" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="0" Grid.Column="1" Text="5000" Width="200" HorizontalAlignment="Left"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Scan Rate (ms):" Style="{StaticResource LabelStyle}"/>
                    <TextBox Grid.Row="1" Grid.Column="1" Text="1000" Width="200" HorizontalAlignment="Left"/>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
