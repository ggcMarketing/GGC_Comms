<Window x:Class="IndustrialGateway.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialGateway.UI"
        xmlns:vm="clr-namespace:IndustrialGateway.UI.ViewModels"
        xmlns:converters="clr-namespace:IndustrialGateway.UI.Converters"
        mc:Ignorable="d"
        Title="Industrial Gateway - GGC Automation" Height="700" Width="1200"
        Background="#303030">

    <Window.Resources>
        <!-- GGC Branding Colors -->
        <SolidColorBrush x:Key="GGC_Red" Color="#8c3030"/>
        <SolidColorBrush x:Key="GGC_Dark" Color="#303030"/>
        <SolidColorBrush x:Key="GGC_White" Color="#ffffff"/>
        
        <converters:ConnectionStateToColorConverter x:Key="StateToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- Menu Style -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource GGC_Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- TreeView Style -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#505050"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource GGC_Red}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#a03838"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#404040"/>
            <Setter Property="AlternatingRowBackground" Value="#4a4a4a"/>
        </Style>
        
        <!-- StatusBar Style -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource GGC_Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New Connection" Command="{Binding NewConnectionCommand}"/>
                <Separator/>
                <MenuItem Header="_Save Configuration" Command="{Binding SaveConfigurationCommand}"/>
                <MenuItem Header="_Load Configuration" Command="{Binding LoadConfigurationCommand}"/>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}"/>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="_Settings"/>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}"/>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Connection Tree -->
            <DockPanel Grid.Column="0" Background="#404040">
                <StackPanel DockPanel.Dock="Bottom" Margin="5">
                    <Button Content="Add Modbus TCP" Command="{Binding AddModbusTcpCommand}"/>
                    <Button Content="Add EtherNet/IP" Command="{Binding AddEtherNetIpCommand}"/>
                    <Button Content="Add GE EGD" Command="{Binding AddEgdCommand}"/>
                </StackPanel>
                
                <TreeView ItemsSource="{Binding ConnectionGroups}" 
                          SelectedValuePath="SelectedConnection"
                          Margin="5">
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Connections}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=" (" Margin="5,0,0,0"/>
                                <TextBlock Text="{Binding Connections.Count}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                Fill="{Binding State, Converter={StaticResource StateToColorConverter}}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                         Background="{StaticResource GGC_Red}"/>

            <!-- Right Panel - Configuration Details -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="10">
                    <TextBlock Text="Connection Configuration" 
                              FontSize="20" FontWeight="Bold" 
                              Foreground="{StaticResource GGC_White}"
                              Margin="0,0,0,20"/>
                    
                    <TextBlock Text="Select a connection from the tree to configure its settings."
                              Foreground="{StaticResource GGC_White}"
                              Margin="0,0,0,10"
                              Visibility="{Binding SelectedConnection, Converter={StaticResource BoolToVisConverter}, ConverterParameter=Inverse}"/>
                    
                    <!-- Connection details will be shown here when a connection is selected -->
                    <ContentControl Content="{Binding SelectedConnection}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Active Connections: "/>
                    <TextBlock Text="{Binding ActiveConnectionCount, FallbackValue='0'}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Industrial Gateway v1.0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
