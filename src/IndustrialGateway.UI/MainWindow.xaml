<Window x:Class="IndustrialGateway.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialGateway.UI"
        xmlns:vm="clr-namespace:IndustrialGateway.UI.ViewModels"
        xmlns:views="clr-namespace:IndustrialGateway.UI.Views"
        xmlns:converters="clr-namespace:IndustrialGateway.UI.Converters"
        mc:Ignorable="d"
        Title="Industrial Gateway - GGC Automation" Height="700" Width="1200"
        Background="#303030">

    <Window.Resources>
        <!-- GGC Branding Colors -->
        <SolidColorBrush x:Key="GGC_Red" Color="#8c3030"/>
        <SolidColorBrush x:Key="GGC_Dark" Color="#303030"/>
        <SolidColorBrush x:Key="GGC_White" Color="#ffffff"/>
        
        <converters:ConnectionStateToColorConverter x:Key="StateToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
        
        <!-- Connection Configuration Templates -->
        <DataTemplate x:Key="ModbusTcpConfigTemplate">
            <views:ModbusTcpConfigView/>
        </DataTemplate>
        
        <DataTemplate x:Key="EtherNetIpConfigTemplate">
            <views:EtherNetIpConfigView/>
        </DataTemplate>
        
        <DataTemplate x:Key="EgdConfigTemplate">
            <views:EgdConfigView/>
        </DataTemplate>
        
        <DataTemplate x:Key="DefaultConfigTemplate">
            <TextBlock Text="Select a connection to configure" 
                      Foreground="{StaticResource GGC_White}"
                      FontSize="14"
                      HorizontalAlignment="Center"
                      VerticalAlignment="Center"/>
        </DataTemplate>
        
        <converters:ConnectionConfigTemplateSelector x:Key="ConfigTemplateSelector"
            ModbusTcpTemplate="{StaticResource ModbusTcpConfigTemplate}"
            EtherNetIpTemplate="{StaticResource EtherNetIpConfigTemplate}"
            EgdTemplate="{StaticResource EgdConfigTemplate}"
            DefaultTemplate="{StaticResource DefaultConfigTemplate}"/>
        
        <!-- Menu Style -->
        <Style TargetType="Menu">
            <Setter Property="Background" Value="{StaticResource GGC_Dark}"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
        </Style>
        
        <!-- MenuItem Style with proper popup background -->
        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8,5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="Border"
                               Background="{TemplateBinding Background}"
                               BorderBrush="{TemplateBinding BorderBrush}"
                               BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Icon"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Shortcut"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                
                                <ContentPresenter Grid.Column="0"
                                                ContentSource="Icon"
                                                Margin="5,0,5,0"
                                                VerticalAlignment="Center"/>
                                
                                <ContentPresenter Grid.Column="1"
                                                ContentSource="Header"
                                                RecognizesAccessKey="True"
                                                VerticalAlignment="Center"
                                                Margin="5,0,10,0"/>
                                
                                <TextBlock Grid.Column="2"
                                          Text="{TemplateBinding InputGestureText}"
                                          Margin="10,0,5,0"
                                          VerticalAlignment="Center"
                                          Foreground="#CCCCCC"/>
                                
                                <Path Grid.Column="3"
                                     x:Name="ArrowPath"
                                     Data="M 0 0 L 4 3.5 L 0 7 Z"
                                     Fill="#FFFFFF"
                                     Margin="5,0,5,0"
                                     VerticalAlignment="Center"
                                     Visibility="Collapsed"/>
                                
                                <Popup x:Name="PART_Popup"
                                      Placement="Right"
                                      IsOpen="{TemplateBinding IsSubmenuOpen}"
                                      AllowsTransparency="True"
                                      Focusable="False"
                                      PopupAnimation="Fade">
                                    <Border Background="#404040"
                                           BorderBrush="{StaticResource GGC_Red}"
                                           BorderThickness="1"
                                           Padding="2">
                                        <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Role" Value="TopLevelHeader">
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                                <Setter TargetName="PART_Popup" Property="Placement" Value="Bottom"/>
                            </Trigger>
                            <Trigger Property="Role" Value="TopLevelItem">
                                <Setter TargetName="Border" Property="Background" Value="Transparent"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="ArrowPath" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="Border" Property="Background" Value="{StaticResource GGC_Red}"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="#808080"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- TreeView Style -->
        <Style TargetType="TreeView">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- GroupBox Style -->
        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- TextBox Style -->
        <Style TargetType="TextBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Background" Value="#505050"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <!-- Label Style -->
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- Button Style -->
        <Style TargetType="Button">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Background" Value="{StaticResource GGC_Red}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#a03838"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- ComboBox Style -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#505050"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
        
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Padding" Value="8,5"/>
            <Style.Triggers>
                <Trigger Property="IsHighlighted" Value="True">
                    <Setter Property="Background" Value="{StaticResource GGC_Red}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{StaticResource GGC_Red}"/>
                    <Setter Property="Foreground" Value="#FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        
        <!-- DataGrid Style -->
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#404040"/>
            <Setter Property="AlternatingRowBackground" Value="#4a4a4a"/>
        </Style>
        
        <!-- StatusBar Style -->
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{StaticResource GGC_Dark}"/>
            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
        </Style>
        
        <!-- ContextMenu Style -->
        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#404040"/>
            <Setter Property="BorderBrush" Value="{StaticResource GGC_Red}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Menu Bar -->
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="_New" Command="{Binding NewConfigurationCommand}" InputGestureText="Ctrl+N">
                    <MenuItem.Icon>
                        <TextBlock Text="📄" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="_Open..." Command="{Binding OpenConfigurationCommand}" InputGestureText="Ctrl+O">
                    <MenuItem.Icon>
                        <TextBlock Text="📂" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="_Save" Command="{Binding SaveConfigurationCommand}" InputGestureText="Ctrl+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="Save _As..." Command="{Binding SaveAsConfigurationCommand}" InputGestureText="Ctrl+Shift+S">
                    <MenuItem.Icon>
                        <TextBlock Text="💾" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
                <Separator/>
                <MenuItem Header="E_xit" Command="{Binding ExitCommand}" InputGestureText="Alt+F4">
                    <MenuItem.Icon>
                        <TextBlock Text="🚪" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Configuration">
                <MenuItem Header="_Settings" IsEnabled="False">
                    <MenuItem.Icon>
                        <TextBlock Text="⚙" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About" Command="{Binding AboutCommand}">
                    <MenuItem.Icon>
                        <TextBlock Text="ℹ" FontSize="14"/>
                    </MenuItem.Icon>
                </MenuItem>
            </MenuItem>
        </Menu>

        <!-- Main Content Area -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left Panel - Connection Tree -->
            <DockPanel Grid.Column="0" Background="#404040">
                <StackPanel DockPanel.Dock="Bottom" Margin="5">
                    <Button Content="Add Modbus TCP" Command="{Binding AddModbusTcpCommand}"/>
                    <Button Content="Add EtherNet/IP" Command="{Binding AddEtherNetIpCommand}"/>
                    <Button Content="Add GE EGD" Command="{Binding AddEgdCommand}"/>
                </StackPanel>
                
                <TreeView x:Name="ConnectionTreeView"
                          ItemsSource="{Binding ConnectionGroups}" 
                          SelectedItemChanged="ConnectionTreeView_SelectedItemChanged"
                          Margin="5">
                    <TreeView.ItemContainerStyle>
                        <Style TargetType="TreeViewItem">
                            <Setter Property="Foreground" Value="{StaticResource GGC_White}"/>
                            <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                        </Style>
                    </TreeView.ItemContainerStyle>
                    <TreeView.ItemTemplate>
                        <HierarchicalDataTemplate ItemsSource="{Binding Connections}">
                            <StackPanel Orientation="Horizontal">
                                <StackPanel.ContextMenu>
                                    <ContextMenu Background="#404040" BorderBrush="{StaticResource GGC_Red}">
                                        <MenuItem Header="Add Connection" 
                                                 Command="{Binding PlacementTarget.DataContext.DataContext.AddConnectionToGroupCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                 Foreground="#FFFFFF">
                                            <MenuItem.Icon>
                                                <TextBlock Text="➕" FontSize="14"/>
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </StackPanel.ContextMenu>
                                <TextBlock Text="{Binding Name}" FontWeight="Bold"/>
                                <TextBlock Text=" (" Margin="5,0,0,0"/>
                                <TextBlock Text="{Binding Connections.Count}"/>
                                <TextBlock Text=")"/>
                            </StackPanel>
                            <HierarchicalDataTemplate.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.ContextMenu>
                                            <ContextMenu Background="#404040" BorderBrush="{StaticResource GGC_Red}">
                                                <MenuItem Header="Remove Connection" 
                                                         Command="{Binding PlacementTarget.DataContext.DataContext.RemoveConnectionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                         CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                         Foreground="#FFFFFF">
                                                    <MenuItem.Icon>
                                                        <TextBlock Text="🗑" FontSize="14"/>
                                                    </MenuItem.Icon>
                                                </MenuItem>
                                            </ContextMenu>
                                        </StackPanel.ContextMenu>
                                        <Ellipse Width="8" Height="8" Margin="0,0,5,0"
                                                Fill="{Binding State, Converter={StaticResource StateToColorConverter}}"/>
                                        <TextBlock Text="{Binding Name}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </HierarchicalDataTemplate.ItemTemplate>
                        </HierarchicalDataTemplate>
                    </TreeView.ItemTemplate>
                </TreeView>
            </DockPanel>

            <!-- Splitter -->
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" 
                         Background="{StaticResource GGC_Red}"/>

            <!-- Right Panel - Configuration Details -->
            <ContentControl Grid.Column="2" 
                          Content="{Binding SelectedConnection}"
                          ContentTemplateSelector="{StaticResource ConfigTemplateSelector}"/>
        </Grid>

        <!-- Status Bar -->
        <StatusBar Grid.Row="2">
            <StatusBarItem>
                <TextBlock Text="{Binding StatusMessage, FallbackValue='Ready'}"/>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Active Connections: "/>
                    <TextBlock Text="{Binding ActiveConnectionCount, FallbackValue='0'}"/>
                </StackPanel>
            </StatusBarItem>
            <Separator/>
            <StatusBarItem HorizontalAlignment="Right">
                <TextBlock Text="Industrial Gateway v1.0"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
