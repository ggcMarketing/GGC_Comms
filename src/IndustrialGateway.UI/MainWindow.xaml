<Window x:Class="IndustrialGateway.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:IndustrialGateway.UI"
        xmlns:views="clr-namespace:IndustrialGateway.UI.Views"
        xmlns:converters="clr-namespace:IndustrialGateway.UI.Converters"
        mc:Ignorable="d"
        Title="Industrial Gateway - Protocol Interface" Height="700" Width="1200"
        Background="#F5F5F5">

    <Window.Resources>
        <converters:ConnectionStateToColorConverter x:Key="StateToColorConverter"/>
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="TextBlock" x:Key="LabelStyle">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="5,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,3"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="15,5"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="MinWidth" Value="100"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="#2C3E50" Padding="15">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Industrial Gateway" FontSize="20" FontWeight="Bold" Foreground="White"/>
                    <TextBlock Text="Multi-Protocol Communication Interface" FontSize="12" Foreground="#BDC3C7"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Protocol:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding SupportedProtocols}"
                              SelectedItem="{Binding SelectedProtocolType}"
                              MinWidth="150"
                              Padding="8,5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content -->
        <Grid Grid.Row="1" Margin="10">
            <!-- Modbus TCP View -->
            <views:ModbusTcpConfigView DataContext="{Binding CurrentProtocolViewModel}"
                                       Visibility="{Binding DataContext.CurrentProtocolViewModel,
                                                           RelativeSource={RelativeSource AncestorType=Window},
                                                           Converter={StaticResource BoolToVisConverter}}"/>

            <!-- Placeholder for other protocols -->
            <Border Background="White"
                    CornerRadius="5"
                    Padding="20"
                    Visibility="{Binding CurrentProtocolViewModel,
                                        Converter={StaticResource BoolToVisConverter}}">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="Protocol Configuration" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Select a protocol from the dropdown above to configure it."
                               Foreground="Gray"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Status Bar -->
        <Border Grid.Row="2" Background="#34495E" Padding="10,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Ready"
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <TextBlock Grid.Column="1"
                           Text="{Binding Source={x:Static local:App.Version}, StringFormat='Version {0}'}"
                           Foreground="#95A5A6"
                           VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </Grid>
</Window>
